{
  "name": "mcp-authprobe",
  "version": "0.1.0-dev",
  "description": "Active authorization testing for remote MCP servers you own: refresh token rotation, redirect_uri strictness and more, as a CLI and an MCP server.",
  "license": "MIT",
  "author": "Enigmacker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Enigmacker/mcp-authprobe.git"
  },
  "bugs": {
    "url": "https://github.com/Enigmacker/mcp-authprobe/issues"
  },
  "homepage": "https://github.com/Enigmacker/mcp-authprobe#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "oauth",
    "security",
    "scanner",
    "sarif"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.18.1"
  },
  "bin": {
    "mcp-authprobe": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  }
}
